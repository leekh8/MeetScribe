#!/bin/sh
# 스테이징된 내용에 실명이 섞였는지 본다.
#
# 2026-09-08에 실명이 public으로 나갔다. 녹음 파일이 아니라 테스트 픽스처와 docstring
# 예시에 손으로 타이핑한 이름이었다. gitignore는 파일을 막지 코드 안의 문자열은 못 막고,
# 하필 이 프로젝트는 "사람 이름을 다루는 기능"이라 테스트를 쓰려면 이름이 필요했다.
# 가장 뚫리기 쉬운 자리에 방어가 없었다.
#
# 대조 명단은 people.local.json과 vocab_ignore.local.json이다. 둘 다 gitignore 대상이라
# 명단 자체는 저장소에 올라가지 않는다. 훅은 읽기만 한다.
#
# 켜기:  git config core.hooksPath .githooks
# 우회:  git commit --no-verify   (정말 필요할 때만)

set -e

ROOT=$(git rev-parse --show-toplevel)
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0

# tr로 CR을 턴다. Windows의 파이썬은 텍스트 모드 stdout에서 \n을 \r\n으로 바꿔 내보내므로
# 그대로 받으면 이름 끝에 CR이 붙는다. grep 패턴에 CR이 섞이면 아무것도 못 찾고,
# 훅은 조용히 통과한다. 막는 장치가 막지 않는 쪽으로 고장나는 모양이라 특히 나쁘다.
NAMES=$(python - "$ROOT" <<'PY' | tr -d '\r'
import json, sys, pathlib
root = pathlib.Path(sys.argv[1])
out = set()
# people.local.json: {"대표이름": ["호칭", "호칭", ...]}
p = root / "people.local.json"
if p.exists():
    try:
        for key, forms in json.loads(p.read_text(encoding="utf-8")).items():
            out.add(key)
            out.update(f for f in forms if isinstance(f, str))
    except Exception:
        pass
# 순수 호칭은 뺀다. 명단에는 "팀장님" 같은 항목도 들어가는데, 그건 누구도 특정하지
# 못하므로 유출이 아니다. 걸러내지 않으면 가명으로 쓴 예시까지 막아서, 곧 훅을
# --no-verify로 우회하는 습관이 든다. 막지 말아야 할 것을 막는 것도 고장이다.
HONORIFICS = {
    "팀장님", "부장님", "과장님", "차장님", "주임님", "책임님", "사장님", "대표님",
    "선임님", "수석님", "이사님", "상무님", "전무님", "님", "선배님", "대리님",
    "팀장", "부장", "과장", "차장", "주임", "책임", "사장", "대표", "선임", "수석",
}

# 2글자 미만은 오탐이 너무 많다. 조사와 붙어 다니는 한글 특성상 경계를 못 건다.
names = sorted(n.strip() for n in out
               if len(n.strip()) >= 2 and n.strip() not in HONORIFICS)
# print를 쓰면 안 된다. Windows 파이썬의 stdout 기본 인코딩은 cp949라 한글 한 자가
# 2바이트로 나가는데, 검사 대상 소스는 UTF-8이다. 바이트가 달라 grep이 영영 못 찾고
# 훅은 통과한다. 원문이 UTF-8이므로 UTF-8 바이트로 직접 쓴다.
sys.stdout.buffer.write("\n".join(names).encode("utf-8"))
PY
)

[ -z "$NAMES" ] && exit 0

# 이름을 패턴 파일로 넘겨 파일당 한 번만 훑는다. 이름마다 grep을 돌리면 한 줄에
# 여러 호칭이 겹칠 때 같은 위치가 여러 번 찍혀 어디를 고쳐야 할지 안 보인다.
PATTERNS=$(mktemp)
trap 'rm -f "$PATTERNS"' EXIT
printf '%s\n' "$NAMES" > "$PATTERNS"

HITS=0
for f in $STAGED; do
    [ -f "$f" ] || continue
    case "$f" in .githooks/*) continue ;; esac
    FOUND=$(grep -n -F -f "$PATTERNS" -- "$f" 2>/dev/null | head -5) || true
    if [ -n "$FOUND" ]; then
        echo "실명으로 보이는 문자열: $f"
        printf '%s\n' "$FOUND" | sed 's/^/    /'
        HITS=$((HITS + 1))
    fi
done

if [ "$HITS" -gt 0 ]; then
    cat <<'MSG'

커밋을 멈췄습니다. 위 위치에 people.local.json의 이름이 들어 있습니다.

예시가 필요하면 가명을 쓰세요: 홍길동 / 김영희 / 이철수
한 번 푸시되면 파일을 고쳐도 히스토리에서는 지워지지 않습니다.

의도한 것이라면 git commit --no-verify
MSG
    exit 1
fi

exit 0
